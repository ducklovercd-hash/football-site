{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": ".test-out",
    "rootDir": "."
  },
  "include": ["lib/fotmob/*.ts", "lib/types.ts", "tests/*.ts"]
}
