# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
#
# Server-side only. Do not prefix with NEXT_PUBLIC_ — keys must not reach the
# browser. All upstream API calls happen inside route handlers / server
# components, so the keys stay on the Vercel server.

# ---------------------------------------------------------------------------
# SofaScore snapshot (the data path this app actually uses)
# ---------------------------------------------------------------------------
# Optional. The same JSON as lib/data/generated/matches.json, as a single line.
# Setting it lets you refresh scores WITHOUT a redeploy: update the variable and
# Vercel restarts the function with the new data.
#
# Produced by:
#   python -m sofascore_scraper.cli --live
#   node scripts/prepare-matches.mjs
#   cat lib/data/generated/matches.json | jq -c .   # one line, for pasting
#
# Limits: Vercel caps env vars at 64 KB total, so keep it to a small window of
# fixtures (roughly 20-40 matches). For anything larger, commit the file and
# redeploy instead.
#
# If it is missing, empty, or invalid JSON the app logs a warning and falls back
# to the committed snapshot, or to demo data. It never fails a build.
FOOTBALL_SNAPSHOT=

# ---------------------------------------------------------------------------
# Optional live providers (not required — demo data works with no keys at all)
# ---------------------------------------------------------------------------

# Primary provider (free, 10 calls/min, 12 competitions, delayed scores).
FOOTBALL_DATA_KEY=

# Optional premium provider (real-time live scores, lineups, stats, odds).
API_FOOTBALL_KEY=

# "demo" = no API calls, deterministic mock data (current default)
# "live"  = call the real providers through the cached route handlers
DATA_MODE=demo

