# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).
#
# Server-side only. Do not prefix with NEXT_PUBLIC_ — keys must not reach the
# browser. All upstream API calls happen inside route handlers / server
# components, so the keys stay on the Vercel server.

# Primary provider (free, 10 calls/min, 12 competitions, delayed scores).
FOOTBALL_DATA_KEY=

# Optional premium provider (real-time live scores, lineups, stats, odds).
API_FOOTBALL_KEY=

# "demo" = no API calls, deterministic mock data (current default)
# "live"  = call the real providers through the cached route handlers
DATA_MODE=demo
